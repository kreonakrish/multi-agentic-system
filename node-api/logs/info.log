[2025-06-08T18:38:42.633Z] [INFO] Executing query:
{
  "query": "\n                SELECT \n                    m.id,\n                    m.conversation_id,\n                    COALESCE(sa.name, 'OpenAI') as source_agent,\n                    COALESCE(ta.name, 'OpenAI') as target_agent,\n                    m.interaction_type,\n                    m.status,\n                    m.created_at as timestamp,\n                    m.content,\n                    m.processed_message,\n                    m.model_response\n                FROM messages m\n                LEFT JOIN agents sa ON m.sender_id = sa.id\n                LEFT JOIN agents ta ON m.receiver_id = ta.id\n                WHERE 1=1\n             AND m.team_id = ? ORDER BY m.created_at DESC",
  "params": [
    "76"
  ]
}

